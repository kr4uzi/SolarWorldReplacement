; PV Monitor configuration.
; Copy to .env and fill in. Read with PHP's built-in parse_ini_file(), so
; values are plain KEY=value. Quote anything containing spaces or ; # = characters.
;
; SECURITY: this file holds the database password, the Meta token and the app
; secret. It must never be served. The bundled .htaccess denies it on Apache;
; on nginx add "location ~ /\.env { deny all; }". Better still, keep it above
; the document root and point PV_ENV_PATH at it.
;
; Real environment variables take precedence over this file.

; --- Database ----------------------------------------------------------------

; Holds accounts, login tokens and scheduling state. Production figures are
; still read from the logger's own files, so there is nothing to import.
DB_HOST     = "localhost"
DB_PORT     = "3306"
DB_NAME     = "pv"
DB_USER     = "pv"
DB_PASSWORD = ""

; Alternatively give a complete DSN and leave the fields above unused:
; DB_DSN = "mysql:host=localhost;dbname=pv;charset=utf8mb4"

; --- Plant -------------------------------------------------------------------

; Where the logger uploads its CSV/JS files. A relative path is resolved from
; the project root, not the working directory, so cron finds it too.
PV_DATA_DIR = "data"

; 12:15 means 12:15 at the plant, whatever the host clock says.
PV_TIMEZONE = "Europe/Berlin"

; --- Money -------------------------------------------------------------------

; Applied to gross production for the money figures. Note this is a single
; blended rate: the logger cannot distinguish self-consumed kWh (which save the
; retail price) from exported kWh (which earn the feed-in tariff), so the
; result is indicative rather than exact.
PV_EUR_PER_KWH = 0.12
PV_CURRENCY    = "€"

; --- Fault detection ---------------------------------------------------------

; Below this much energy accumulated by the trigger time, the plant counts as
; not producing. Even a heavily overcast winter day clears this unless the
; panels are covered.
PV_MIN_MIDDAY_WH = 100

; Newer readings than this are required to judge production at all; past it,
; the logger itself is reported as the fault.
PV_MAX_DATA_AGE_MINUTES = 60

; --- Scheduling --------------------------------------------------------------

; job.php runs every 15 minutes but only acts from this time onwards.
JOB_TRIGGER_TIME = "12:15"

; The monthly report normally goes out on the 1st. If the host was down, a run
; within this many days still delivers it (once - job_runs prevents repeats).
JOB_MONTHLY_CATCHUP_DAYS = 3

; --- Portal ------------------------------------------------------------------

; Public base URL of the app. Used to build the login links sent over WhatsApp,
; so it must be absolute and reachable from a phone. HTTPS strongly advised:
; the link carries a login token.
PORTAL_URL = "https://example.com/pv"

; How long a portal link stays valid. It is single-use regardless.
LOGIN_TOKEN_TTL_MINUTES = 15

; --- Messaging ----------------------------------------------------------------

; Which transport carries alerts, reports and bot replies:
;   whatsapp - Meta Cloud API (needs the META_* settings below)
;   birdy    - BirdyChat (needs the BIRDY_* settings below)
;   http     - post to any HTTP endpoint you describe below
;   log      - writes messages to a file instead of sending them, so the whole
;              system can be exercised without any provider account
MESSAGING_TRANSPORT = "log"

; Where the 'log' transport writes. Defaults to data/messages.log.
MESSAGE_LOG = ""

; --- 'http' transport ---------------------------------------------------------
;
; Describes any service that accepts a plain HTTP request, so a provider can be
; adopted without a bespoke class. Take these four values from its API docs.
;
; {address} is the user's phone or address; {text} is the message. Both are
; escaped for the body's content type, so quotes, newlines and emoji in a
; report cannot break the payload.
;
; Headers are "Name: value" joined by | characters.
;
; Example shape - check the real field names against your provider's docs:
;   HTTP_TRANSPORT_URL     = "https://api.example.com/v1/messages"
;   HTTP_TRANSPORT_HEADERS = "Authorization: Bearer YOUR_KEY|Content-Type: application/json"
;   HTTP_TRANSPORT_BODY    = "{\"to\":\"{address}\",\"text\":\"{text}\"}"
;
HTTP_TRANSPORT_URL     = ""
HTTP_TRANSPORT_METHOD  = "POST"
HTTP_TRANSPORT_HEADERS = "Content-Type: application/json"
HTTP_TRANSPORT_BODY    = "{\"to\":\"{address}\",\"text\":\"{text}\"}"
HTTP_TRANSPORT_TIMEOUT = 20

; --- BirdyChat ----------------------------------------------------------------
;
; Outbound. The field names below are a plausible REST shape, NOT a verified
; contract - confirm them against https://docs.birdy.chat/ and correct them
; here rather than in code. {address} is the user's BirdyChat address and
; {text} the message; both are JSON-escaped before substitution.
BIRDY_API_BASE   = "https://api.birdy.chat"
BIRDY_SEND_PATH  = "/v1/messages"
BIRDY_SEND_METHOD = "POST"
BIRDY_API_TOKEN  = ""
BIRDY_AUTH_HEADER = "Authorization: Bearer {token}"
BIRDY_SEND_BODY  = "{\"to\":\"{address}\",\"text\":\"{text}\"}"
BIRDY_TIMEOUT    = 20

; Inbound, at /birdy-webhook.
;
; The endpoint refuses to run without a secret - an unauthenticated inbound URL
; would let anyone drive the bot. Set 'plain' when BirdyChat sends the secret
; verbatim in a header, 'hmac-sha256' when it signs the request body.
BIRDY_WEBHOOK_SECRET         = ""
BIRDY_WEBHOOK_SECRET_HEADER  = "X-Birdy-Signature"
BIRDY_WEBHOOK_SIGNATURE_MODE = "plain"

; Where to find the sender and the message text in a delivery, as dotted paths.
; Set WEBHOOK_DIAG_KEY and probe the endpoint to see a real payload, then point
; these at the right keys - no code change needed. Set BIRDY_INBOUND_LIST_PATH
; only if deliveries arrive batched as an array.
BIRDY_INBOUND_SENDER_PATH = "sender.email"
BIRDY_INBOUND_TEXT_PATH   = "text"
BIRDY_INBOUND_LIST_PATH   = ""

; --- WhatsApp Cloud API ------------------------------------------------------

; From Meta: App > WhatsApp > API Setup.
META_TOKEN           = ""
META_PHONE_NUMBER_ID = ""
META_API_VERSION     = "v21.0"

; Approved template for messages we start ourselves (report and alert). Its
; body must contain exactly one placeholder, e.g. "PV Anlage: {{1}}".
META_TEMPLATE_NAME = "pv_update"
META_TEMPLATE_LANG = "de"

; Webhook credentials. The verify token is any string you choose and is entered
; identically in Meta's webhook setup; it is only used for the one-time
; registration handshake. The app secret is under App > Settings > Basic and
; signs every real event in the X-Hub-Signature-256 header.
META_VERIFY_TOKEN = ""
META_APP_SECRET   = ""

; --- Optional ----------------------------------------------------------------

; Append webhook activity to this file for debugging. Leave empty to disable.
PV_WEBHOOK_LOG = ""

; Set a secret here to enable the webhook diagnostic probe, then call
;     curl "https://example.com/pv/webhook?diag=THE_KEY&hub.mode=subscribe&hub.verify_token=YOUR_TOKEN&hub.challenge=123"
; It reports what the server actually received and why a handshake would fail,
; comparing secrets by hash prefix only. Leave empty in normal operation - while
; empty the probe does not exist, and the endpoint behaves exactly as before.
WEBHOOK_DIAG_KEY = ""
