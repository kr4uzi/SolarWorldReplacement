; PV Monitor configuration.
; Copy to .env and fill in. Read with PHP's built-in parse_ini_file(), so
; values are plain KEY=value. Quote anything containing spaces or ; # = characters.
;
; SECURITY: .env holds your WhatsApp token. It must not be fetchable over the
; web. Either keep it above the document root and point PV_ENV_PATH at it, or
; rely on the bundled .htaccess (Apache only - on nginx add your own deny rule).
;
; Real environment variables take precedence over this file, so a hosting
; panel or systemd unit can override any of these.

; --- Plant -------------------------------------------------------------------

; Where the logger uploads its CSV/JS files.
PV_DATA_DIR = "./data"

; 12:15 means 12:15 here, regardless of the server's clock.
PV_TIMEZONE = "Europe/Zurich"

; --- Money -------------------------------------------------------------------

; Rate applied to production for the € figures. Note this is a single blended
; rate: the logger records gross production and cannot tell self-consumed kWh
; (which save the retail price) from exported kWh (which earn the feed-in
; tariff), so treat the result as an approximation.
PV_EUR_PER_KWH = 0.12
PV_CURRENCY    = "€"

; --- Fault detection ---------------------------------------------------------

; Below this much energy accumulated by 12:15, the plant counts as "no power".
; Even a heavily overcast winter day clears this unless the panels are covered.
PV_MIN_MIDDAY_WH = 100

; If the newest live reading is older than this, treat the logger as offline.
PV_MAX_DATA_AGE_MINUTES = 60

; --- WhatsApp Cloud API ------------------------------------------------------

; From Meta: App > WhatsApp > API Setup.
WHATSAPP_TOKEN           = ""
WHATSAPP_PHONE_NUMBER_ID = ""
WHATSAPP_API_VERSION     = "v21.0"

; Approved template used for messages the plant starts on its own (alerts and
; reports). Its body must contain exactly one placeholder, e.g.
;     PV Monitor update: {{1}}
WHATSAPP_TEMPLATE_NAME = "pv_update"
WHATSAPP_TEMPLATE_LANG = "en"

; Who receives alerts and the monthly/yearly reports. Comma-separated,
; international format; punctuation is ignored.
WHATSAPP_RECIPIENTS = "+41791234567"

; Who may query the bot. Anyone not listed here is ignored, so leaving this
; empty disables the menu entirely (safe default - do not use "*").
WHATSAPP_ALLOWED_SENDERS = "+41791234567"

; Webhook security. The verify token is any string you choose; you enter the
; same one in Meta's webhook setup. The app secret is under App > Settings >
; Basic and is used to check that payloads genuinely come from Meta.
WHATSAPP_VERIFY_TOKEN = ""
WHATSAPP_APP_SECRET   = ""

; --- Optional ----------------------------------------------------------------

; Required only if you trigger pv_daily.php over HTTP instead of cron.
PV_CRON_KEY = ""

; Email copy of alerts and reports. Handy as a fallback while WhatsApp is
; still being set up. Leave empty to disable.
PV_NOTIFY_EMAIL = ""
PV_FROM_EMAIL   = ""

; Append webhook activity to this file for debugging. Leave empty to disable.
PV_WEBHOOK_LOG = ""
