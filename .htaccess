# Everything goes through the front controller, which is where authentication
# is decided. Nothing else at the web root should be reachable directly.

# The rewrite below cannot handle a request for a directory - "/" included,
# since %{REQUEST_FILENAME} then names a directory that exists and the !-d
# condition skips the rule. Without an index file Apache answers its own 403,
# so the dashboard is unreachable while every other route works. Naming the
# front controller as the index is what makes "/" resolve.
DirectoryIndex System.php

RewriteEngine On

# The logger's upload directory holds production data, the job's state and,
# with the log transport, message contents. It cannot carry its own .htaccess
# because the directory is gitignored, so deny it here - the pattern is
# relative to this file, so it holds in a subdirectory install too.
RewriteRule ^(data|backup)/ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ System.php [QSA,L]

# The rewrite above deliberately skips files that exist, so any PHP file left
# in the web root is still executed directly. That matters when upgrading over
# an older deployment: git does not remove files it never tracked, so the
# previous entry points survive the pull and would serve the dashboard and the
# API with no session check at all.
#
# Deny every entry point this project has ever shipped. Deleting the stale
# files is still the right fix - this only makes forgetting harmless.
<FilesMatch "^(index|api|webhook|setup|job|zero_day_check|pv_daily|pv_data|pv_messages|pv_whatsapp)\.php$">
    Require all denied
</FilesMatch>

# Configuration is never served, even if the rewrite is bypassed or
# mod_rewrite is unavailable.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
