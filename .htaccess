# Everything goes through the front controller, which is where authentication
# is decided. Nothing else at the web root should be reachable directly.

RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ System.php [QSA,L]

# Config, CLI tools and logger data are never served, even if a rewrite is
# bypassed or mod_rewrite is unavailable.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "^(setup|job)\.php$">
    Require all denied
</FilesMatch>
